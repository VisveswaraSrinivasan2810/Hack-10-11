# Copy to .env — never commit the real file.
POSTGRES_PASSWORD=civiclens_dev
# 32+ random characters. Generate e.g. with:  openssl rand -base64 48
JWT_KEY=change-me-to-a-long-random-secret-at-least-32-chars
# Seeds the fictional demo city and enables the "Demo Scenario" tools. Demo accounts use a documented password: development only!
DEMO_MODE=true
ASPNETCORE_ENVIRONMENT=Development
# AI provider: Demo (offline, deterministic, default) or Claude (real vision; falls back to Demo on any failure)
AI_PROVIDER=Demo
AI_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
CORS_ORIGIN=http://localhost:4200
